CCEffect %{
  techniques:
  - passes:
    - vert: fire-overlay-vs:vert
      frag: fire-overlay-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        fireColorInner: { value: [1.0, 0.9, 0.1, 1.0], editor: { type: color } }
        fireColorOuter: { value: [1.0, 0.2, 0.0, 1.0], editor: { type: color } }
        fireIntensity: { value: 1.2, target: params.x, editor: { slide: true, range: [0.0, 3.0] } }
        fireSpeed: { value: 1.5, target: params.y, editor: { slide: true, range: [0.2, 5.0] } }
        fireDetail: { value: 10.0, target: params.z, editor: { slide: true, range: [3.0, 25.0] } }
        distortion: { value: 0.3, target: params.w, editor: { slide: true, range: [0.0, 1.0] } }
}%

CCProgram fire-overlay-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram fire-overlay-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform FireParams {
    vec4 fireColorInner;
    vec4 fireColorOuter;
    vec4 params;  // x: intensity, y: speed, z: detail, w: distortion
  };

  // ---- Hash / Noise ----
  float hash2(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
  }

  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
      mix(hash2(i), hash2(i + vec2(1.0, 0.0)), f.x),
      mix(hash2(i + vec2(0.0, 1.0)), hash2(i + vec2(1.0, 1.0)), f.x),
      f.y
    );
  }

  float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    float f = 1.0;
    for (int i = 0; i < 3; i++) {
      v += a * noise(p * f);
      f *= 2.0;
      a *= 0.5;
    }
    return v;
  }

  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);

    // ---- Flame noise layers ----
    float t = cc_time.x * params.y;

    // Layer 1: slow rolling heat
    float n1 = fbm(uv0 * params.z * 0.6 + vec2(0.0, t * 0.3));

    // Layer 2: fast flickering detail (stretched vertically for fire streaks)
    float n2 = fbm(uv0 * params.z * 1.4 + vec2(t * 0.5, t * 0.8));

    // Layer 3: high-frequency sparks
    float n3 = noise(uv0 * params.z * 3.0 + vec2(t * 1.2, -t * 1.0)) * 0.3;

    // Combine layers
    float flame = n1 * 0.5 + n2 * 0.35 + n3 * 0.15;

    // ---- Fire color ramp ----
    // Low flame → dark red, mid → orange, high → yellow/white
    float flameSmooth = smoothstep(0.2, 0.7, flame);
    vec3 fireColor = mix(fireColorOuter.rgb, fireColorInner.rgb, flameSmooth);

    // White-hot peaks
    float peak = smoothstep(0.8, 0.95, flame);
    fireColor = mix(fireColor, vec3(1.0, 1.0, 0.95), peak * 0.4);

    // ---- Distortion (heat shimmer) ----
    vec2 uvDistorted = uv0;
    if (params.w > 0.01) {
      float dx = (n2 - 0.5) * params.w * 0.03;
      float dy = (n1 - 0.5) * params.w * 0.03;
      uvDistorted = uv0 + vec2(dx, dy);
    }

    // ---- Composite ----
    // Fire covers the sprite wherever it's opaque
    float fireMask = smoothstep(0.25, 0.65, flame) * params.x;

    // Blend fire over distorted sprite
    vec4 texDistorted = CCSampleWithAlphaSeparated(cc_spriteTexture, uvDistorted);
    o.rgb = mix(texDistorted.rgb, fireColor, fireMask * texDistorted.a);

    ALPHA_TEST(o);
    o *= color;
    return o;
  }
}%

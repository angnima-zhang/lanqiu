CCEffect %{
  techniques:
  - passes:
    - vert: flame-frame-vs:vert
      frag: flame-frame-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        flameColorInner: { value: [1.0, 0.95, 0.2, 1.0], editor: { type: color } }
        flameColorOuter: { value: [1.0, 0.25, 0.0, 1.0], editor: { type: color } }
        flameHeight: { value: 6.0, target: params.x, editor: { slide: true, range: [1.0, 20.0] } }
        flameIntensity: { value: 1.5, target: params.y, editor: { slide: true, range: [0.2, 4.0] } }
        flameSpeed: { value: 1.2, target: params.z, editor: { slide: true, range: [0.2, 5.0] } }
        flameDetail: { value: 8.0, target: params.w, editor: { slide: true, range: [3.0, 20.0] } }
}%

CCProgram flame-frame-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram flame-frame-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform FlameParams {
    vec4 flameColorInner;
    vec4 flameColorOuter;
    vec4 params;  // x: flameHeight, y: flameIntensity, z: flameSpeed, w: flameDetail
  };

  // ---- Hash / Noise ----
  float hash2(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
  }

  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
      mix(hash2(i), hash2(i + vec2(1.0, 0.0)), f.x),
      mix(hash2(i + vec2(0.0, 1.0)), hash2(i + vec2(1.0, 1.0)), f.x),
      f.y
    );
  }

  float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    float f = 1.0;
    for (int i = 0; i < 3; i++) {
      v += a * noise(p * f);
      f *= 2.1;
      a *= 0.5;
    }
    return v;
  }

  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);

    // ---- Edge detection via alpha blur ----
    // flameHeight → UV offset (normalized to ~500px sprite)
    float stepX = params.x / 500.0;
    float stepY = stepX;

    float a_l = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(-stepX, 0.0)).a;
    float a_r = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2( stepX, 0.0)).a;
    float a_t = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(0.0,  stepY)).a;
    float a_b = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + vec2(0.0, -stepY)).a;

    // Blurred alpha: average of center + 4 neighbors
    float blurAlpha = (o.a + a_l + a_r + a_t + a_b) * 0.2;

    // Edge proximity: where original alpha < blurredAlpha → near sprite boundary
    float edgeProximity = max(blurAlpha - o.a, 0.0);

    // ---- Flame noise ----
    // Stretch noise vertically for natural flame tongues
    vec2 noiseUV = vec2(uv0.x * params.w, uv0.y * params.w * 0.45);
    // Rising flame animation
    noiseUV.y += params.z * 0.8 * sin(cc_time.x * params.z * 0.7);

    float n1 = fbm(noiseUV + cc_time.x * params.z * 0.4);
    float n2 = fbm(noiseUV * 1.7 - cc_time.x * params.z * 0.6);
    float flameNoise = n1 * 0.6 + n2 * 0.4;

    // ---- Flame intensity ----
    // Flame only shows in transparent/near-edge zone, shaped by noise
    float flame = edgeProximity * flameNoise * params.y;
    flame = clamp(flame, 0.0, 1.0);

    // Apply smooth threshold for cleaner flame shapes
    float flameSharp = smoothstep(0.03, 0.15, flame);
    float flameSoft = smoothstep(0.0, 0.08, flame);

    // ---- Fire color gradient ----
    // Low flame → outer color (red/orange), high flame → inner color (yellow/white)
    vec3 fireColor = mix(flameColorOuter.rgb, flameColorInner.rgb, flameSoft);

    // ---- Composite ----
    // Flame renders in transparent areas near edges
    o.rgb = mix(o.rgb, fireColor, flameSharp * (1.0 - o.a));

    // Subtle inner glow bleed (flame light on sprite edges)
    float innerBleed = flameSharp * o.a * 0.2;
    o.rgb = mix(o.rgb, flameColorInner.rgb * 0.6, innerBleed);

    ALPHA_TEST(o);
    o *= color;
    return o;
  }
}%

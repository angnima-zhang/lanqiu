// "The Universe Within" by Martijn Steinrucken (BigWings) 2018
// Adapted from ShaderToy: https://www.shadertoy.com/view/lscczl
// Cocos Creator 3.7.x version by yeshao2069 → adapted to 3.8.7
//
// Changes from original:
// - texture binding 11 → 12 (Cocos 3.8 standard)
// - fft audio data → time-driven pulse (no audio in game context)
// - resolution set dynamically via component

CCEffect %{
  techniques:
  - passes:
    - vert: universe-vs:vert
      frag: universe-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        resolution: { value: [584.0, 571.0], target: resolution }
        rotationSpeed: { value: 0.1, target: tune.x, editor: { slide: true, range: [0.02, 0.5] } }
        glowIntensity: { value: 2.0, target: tune.y, editor: { slide: true, range: [0.0, 5.0] } }
        blendStrength: { value: 0.6, target: tune.z, editor: { slide: true, range: [0.0, 1.0] } }
        sparkleBoost: { value: 1.0, target: tune.w, editor: { slide: true, range: [0.0, 3.0] } }
        paletteBase: { value: [0.282, 0.565, 0.847, 1.0], target: paletteTintA, editor: { type: color } }
        paletteAccent: { value: [0.816, 0.941, 1.0, 1.0], target: paletteTintB, editor: { type: color } }
        palettePrism: { value: 0.0, target: paletteParams.x, editor: { slide: true, range: [0.0, 1.0] } }
        uvOriginAxis: { value: [0.0, 1.0, 1.0, 0.0] }
        uvUpAxis: { value: [0.0, -1.0, 0.0, 0.0] }
}%

CCProgram universe-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram universe-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  #include <builtin/uniforms/cc-global>

  in vec4 color;

  #pragma define S(a, b, t) smoothstep(a, b, t)
  #pragma define NUM_LAYERS 4.

  uniform MXD {
    vec2 resolution;
  };

  uniform Tune {
    vec4 tune;  // x: rotationSpeed, y: glowIntensity, z: blendStrength, w: sparkleBoost
  };

  uniform Palette {
    vec4 paletteTintA;
    vec4 paletteTintB;
    vec4 paletteParams;
  };

  uniform SpriteUV {
    vec4 uvOriginAxis;
    vec4 uvUpAxis;
  };

  // ---- Noise / Grid helpers ----

  float N21(vec2 p) {
    vec3 a = fract(vec3(p.xyx) * vec3(213.897, 653.453, 253.098));
    a += dot(a, a.yzx + 79.76);
    return fract((a.x + a.y) * a.z);
  }

  vec2 GetPos(vec2 id, vec2 offs, float t) {
    float n = N21(id + offs);
    float n1 = fract(n * 10.);
    float n2 = fract(n * 100.);
    float a = t + n;
    return offs + vec2(sin(a * n1), cos(a * n2)) * .4;
  }

  float df_line(vec2 a, vec2 b, vec2 p) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.);
    return length(pa - ba * h);
  }

  float line(vec2 a, vec2 b, vec2 uv) {
    float r1 = .04;
    float r2 = .01;
    float d = df_line(a, b, uv);
    float d2 = length(a - b);
    float fade = S(1.5, .5, d2);
    fade += S(.05, .02, abs(d2 - .75));
    return S(r1, r2, d) * fade;
  }

  float NetLayer(vec2 st, float n, float t) {
    vec2 id = floor(st) + n;
    st = fract(st) - .5;

    vec2 p[9];
    p[0] = GetPos(id, vec2(-1., -1.), t);
    p[1] = GetPos(id, vec2(0., -1.), t);
    p[2] = GetPos(id, vec2(1., -1.), t);
    p[3] = GetPos(id, vec2(-1., 0.), t);
    p[4] = GetPos(id, vec2(0., 0.), t);
    p[5] = GetPos(id, vec2(1., 0.), t);
    p[6] = GetPos(id, vec2(-1., 1.), t);
    p[7] = GetPos(id, vec2(0., 1.), t);
    p[8] = GetPos(id, vec2(1., 1.), t);

    float m = 0.;
    float sparkle = 0.;

    for (int i = 0; i < 9; i++) {
      m += line(p[4], p[i], st);
      float d = length(st - p[i]);
      float s = (.005 / (d * d));
      s *= S(1., .7, d);
      float pulse = sin((fract(p[i].x) + fract(p[i].y) + t) * 5.) * .4 + .6;
      pulse = pow(pulse, 20.);
      s *= pulse;
      sparkle += s;
    }

    m += line(p[1], p[3], st);
    m += line(p[1], p[5], st);
    m += line(p[7], p[5], st);
    m += line(p[7], p[3], st);

    float sPhase = (sin(t + n) + sin(t * .1)) * .25 + .5;
    sPhase += pow(sin(t * .1) * .5 + .5, 50.) * 5.;
    m += sparkle * sPhase * tune.w;
    return m;
  }

  // ---- Sprite texture (optional overlay) ----
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  vec4 frag () {
    vec4 o = vec4(1.0);

    // Blend sprite texture as base
    vec4 texColor = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    o.rgb = texColor.rgb;

    vec2 r = resolution;
    vec2 deltaUV = uv0 - uvOriginAxis.xy;
    vec2 rightUV = uvOriginAxis.zw;
    vec2 upUV = uvUpAxis.xy;
    float determinant = rightUV.x * upUV.y - rightUV.y * upUV.x;
    vec2 spriteUV = vec2(
      (deltaUV.x * upUV.y - deltaUV.y * upUV.x) / determinant,
      1.0 - (rightUV.x * deltaUV.y - rightUV.y * deltaUV.x) / determinant
    );
    vec2 fragCoord = spriteUV * r;

    vec2 uv = (fragCoord - r * .5) / r.y;
    float t = cc_time.x * tune.x;

    float s = sin(t);
    float c = cos(t);
    mat2 rot = mat2(c, -s, s, c);
    vec2 st = uv * rot;

    float m = 0.;
    for (float i = 0.; i < 1.; i += 1. / NUM_LAYERS) {
      float z = fract(t + i);
      float size = mix(15., 1., z);
      float fade = S(0., .6, z) * S(1., .8, z);
      m += fade * NetLayer(st * size, i, cc_time.x);
    }

    // Time-driven pulse (replaces original audio FFT)
    float pulse = 0.4 + 0.3 * sin(cc_time.x * 0.7) + 0.15 * sin(cc_time.x * 1.3);
    float glow = -uv.y * pulse * tune.y;
    float paletteWave = .5 + .5 * sin(t * .37 + uv.x * 3. + uv.y * 1.5);
    vec3 tintedBase = mix(paletteTintA.rgb, paletteTintB.rgb, .22 + paletteWave * .32);
    vec3 prism = .5 + .5 * cos(6.28318 * (
      vec3(0., .33, .67) + t * .035 + uv.x * .11 - uv.y * .09
    ));
    vec3 baseCol = mix(tintedBase, mix(tintedBase, prism, .55), paletteParams.x);
    vec3 col = baseCol * m;
    col += baseCol * glow;

    // Circular vignette
    col *= 1. - dot(uv, uv);
   

    // Blend: cosmic overlay on top of sprite
    o.rgb = mix(o.rgb, col, tune.z);
    o.a = texColor.a;

    ALPHA_TEST(o);
    o *= color;
    return o;
  }
}%

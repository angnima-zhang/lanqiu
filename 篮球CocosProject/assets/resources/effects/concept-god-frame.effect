CCEffect %{
  techniques:
  - passes:
    - vert: concept-god-frame-vs:vert
      frag: concept-god-frame-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        goldColor: { value: [1.0, 0.73, 0.12, 1.0], editor: { type: color } }
        glintColor: { value: [1.0, 0.97, 0.82, 1.0], editor: { type: color } }
        period: { value: 5.4, target: params.x }
        sweepWidth: { value: 0.16, target: params.y }
        intensity: { value: 0.38, target: params.z }
        rainbowAmount: { value: 0.58, target: params.w }
}%

CCProgram concept-god-frame-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return pos;
  }
}%

CCProgram concept-god-frame-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform ConceptGodFrame {
    vec4 goldColor;
    vec4 glintColor;
    vec4 params;
  };

  float hash21(vec2 p) {
    return fract(sin(dot(p, vec2(93.17, 191.39))) * 45123.289);
  }

  vec3 rainbow(float t) {
    return 0.5 + 0.5 * cos(6.2831853 * (t + vec3(0.0, 0.333, 0.667)));
  }

  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    float period = max(params.x, 0.1);
    float phase = fract(cc_time.x / period);
    float width = max(params.y, 0.01);
    float axis = uv0.x + (uv0.y - 0.5) * 0.27;
    float center = mix(-width, 1.0 + width, phase);
    float sweep = 1.0 - smoothstep(width * 0.3, width, abs(axis - center));
    float micro = smoothstep(0.968, 0.997, hash21(floor(uv0 * 58.0) + floor(phase * 9.0)));
    vec3 prismatic = rainbow(axis * 0.82 + phase * 0.36);
    float amount = params.z * o.a;
    o.rgb = mix(o.rgb, goldColor.rgb, amount * 0.16);
    o.rgb += goldColor.rgb * (sweep * 0.55 + micro * 0.16) * amount;
    o.rgb += mix(glintColor.rgb, prismatic, params.w) * (sweep * 0.62 + micro) * amount;
    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%

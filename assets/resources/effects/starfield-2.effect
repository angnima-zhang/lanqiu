CCEffect %{
  techniques:
  - passes:
    - vert: starfield-vs:vert
      frag: starfield-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        animSpeed: { value: 0.0, target: starParams.x }
        starBrightness: { value: 0.05, target: starParams.y }
        dust: { value: 0.125, target: starParams.z }
        distFade: { value: 0.35, target: starParams.w }
        pixelation: { value: 1000.0, target: retroParams.x }
        quantizationLevels: { value: 256.0, target: retroParams.y }
        saturation: { value: 1.0, target: retroParams.z }
        layers: { value: 4.0, target: retroParams.w }
        dustColor: { value: [0.0, 0.216, 0.294, 1.0], editor: { type: color } }
        mixFactor: { value: 0.6, target: nodeSize.z }
        nodeWidth: { value: 512, target: nodeSize.x }
        nodeHeight: { value: 512, target: nodeSize.y }
}%

CCProgram starfield-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram starfield-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform Starfield {
    vec4 starParams;   // x: animSpeed, y: starBrightness, z: dust, w: distFade
    vec4 retroParams;  // x: pixelation, y: quantizationLevels, z: saturation, w: layers
    vec4 dustColor;    // rgb: dust color
    vec4 nodeSize;     // x: width, y: height, z: mixFactor
  };

  const float formuparam2 = 0.79;
  const float zoom = 1.0;
  const float tile = 0.850;
  const float stepsize = 0.29;

  float field(in vec3 p) {
    float strength = 7.0 + 0.03 * fract(sin(cc_time.x) * 373.11);
    float accum = 0.0;
    float prev = 0.0;
    float tw = 0.0;

    for (int i = 0; i < 5; ++i) {
      float mag = dot(p, p);
      p = abs(p) / mag + vec3(-0.5, -0.8 + 0.1 * sin(-cc_time.x * 0.1 + 2.0), -1.1 + 0.3 * cos(cc_time.x * 0.3));
      float w = exp(-float(i) / 7.0);
      accum += w * exp(-strength * pow(abs(mag - prev), 2.3));
      tw += w;
      prev = mag;
    }
    return max(0.0, 5.0 * accum / tw - 0.7);
  }

  vec2 pixelateUV(vec2 uv, float px) {
    float scale = max(nodeSize.x, 1.0) / 512.0;
    if (px < 1000.0) {
      return floor(uv * px * scale) / (px * scale);
    }
    return uv;
  }

  vec4 frag() {
    vec4 base = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    vec2 uv = pixelateUV(uv0, retroParams.x);

    float time = cc_time.x;
    float speed = starParams.x;

    float a_xz = 0.9;
    float a_yz = -0.6;
    float a_xy = 0.9 + time * 0.009;

    mat2 rot_xz = mat2(vec2(cos(a_xz), sin(a_xz)), vec2(-sin(a_xz), cos(a_xz)));
    mat2 rot_yz = mat2(vec2(cos(a_yz), sin(a_yz)), vec2(-sin(a_yz), cos(a_yz)));
    mat2 rot_xy = mat2(vec2(cos(a_xy), sin(a_xy)), vec2(-sin(a_xy), cos(a_xy)));

    float v2 = 1.0;
    vec3 dir = vec3(uv * zoom, 1.0);
    vec3 from = vec3(0.0);

    from.x += cos(0.01 * time) + 0.001 * time;
    from.y += sin(0.01 * time) + 0.001 * time;
    from.z += 0.003 * time;

    dir.xy *= rot_xy;
    vec3 forward = vec3(0.0, 0.0, 1.0);
    forward.xy *= rot_xy;
    dir.xz *= rot_xz;
    forward.xz *= rot_xz;
    dir.yz *= rot_yz;
    forward.yz *= rot_yz;

    from.xy *= -1.0 * rot_xy;
    from.xz *= rot_xz;
    from.yz *= rot_yz;

    float parallax = (time - 3311.0) * speed * 0.1;
    from += forward * parallax;
    float sampleShift = mod(parallax, stepsize);

    float zoffset = -sampleShift;
    sampleShift /= stepsize;

    float s = 0.24;
    float s3 = s + stepsize * 0.5;
    vec3 v = vec3(0.0);
    float t3 = 0.0;

    vec3 backCol2 = vec3(0.0);

    for (int r = 0; r < 4; r++) {

      vec3 p2 = from + (s + zoffset) * dir;
      vec3 p3 = from + (s3 + zoffset) * dir;

      p2 = abs(vec3(tile) - mod(p2, vec3(tile * 2.0)));
      p3 = abs(vec3(tile) - mod(p3, vec3(tile * 2.0)));
      t3 = field(p3);

      float pa = 0.0;
      float a = 0.0;
      for (int i = 0; i < 8; i++) {
        p2 = abs(p2) / dot(p2, p2) - formuparam2;
        float D = abs(length(p2) - pa);
        a += D;
        pa = length(p2);
      }

      a *= a * a;

      float rf = float(r);
      float fade = pow(starParams.w, max(0.0, rf - sampleShift));
      v += fade;

      if (r == 0)
        fade *= (1.0 - sampleShift);
      if (r == 3)
        fade *= sampleShift;

      float brightness = mix(0.4, 1.0, v2);
      vec3 starColor = dustColor.rgb * brightness * vec3(1.8 * t3 * t3 * t3, 1.4 * t3 * t3, t3) * fade;

      v += vec3(s, s * s, s * s * s * s) * a * starParams.y * fade;
      backCol2 += starColor;

      s += stepsize;
      s3 += stepsize;
    }

    float sat = retroParams.z;
    v = mix(vec3(length(v)), v, sat);
    backCol2 = mix(vec3(length(backCol2)), backCol2, sat);

    vec3 finalColor = v * 0.01 + backCol2 * starParams.z * sat;

    int ql = int(retroParams.y);
    if (ql < 256)
      finalColor = floor(finalColor * float(ql)) / float(ql);

    vec4 o;
    o.rgb = mix(base.rgb, finalColor, nodeSize.z);
    o.a = base.a;

    ALPHA_TEST(o);
    o *= color;
    return o;
  }
}%

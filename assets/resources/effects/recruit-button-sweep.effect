CCEffect %{
  techniques:
  - passes:
    - vert: recruit-sweep-vs:vert
      frag: recruit-sweep-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        sweepWidth: { value: 0.14, target: sweepParams.x }
        sweepPeriod: { value: 1.5, target: sweepParams.y }
        sweepSlope: { value: 0.16, target: sweepParams.z }
        rainbowIntensity: { value: 0.36, target: sweepParams.w }
        rainbowSpeed: { value: 0.12, target: diffracParams.x }
        rainbowSpread: { value: 1.6, target: diffracParams.y }
}%

CCProgram recruit-sweep-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram recruit-sweep-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform RecruitSweep {
    vec4 sweepParams;   // .w = rainbowIntensity
    vec4 diffracParams; // .x = speed, .y = spread
  };

  // ---- Spectrum: diffraction grating → RGB ----
  vec3 spectrum(float t) {
    float tau = 6.283185307;
    return vec3(
      0.5 + 0.5 * sin(tau * (t + 0.000)),
      0.5 + 0.5 * sin(tau * (t + 0.333)),
      0.5 + 0.5 * sin(tau * (t + 0.667))
    );
  }

  vec4 frag () {
    vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);

    #if IS_GRAY
      float gray = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
      o.r = o.g = o.b = gray;
    #else
      // 只保留低频、局部掠过的镭射带，避免整块按钮持续变彩。
      float width = max(sweepParams.x, 0.001);
      float slope = sweepParams.z;
      float axis = uv0.x + (uv0.y - 0.5) * slope;
      float minAxis = min(0.0, -slope * 0.5);
      float maxAxis = 1.0 + max(0.0, slope * 0.5);
      float period = max(sweepParams.y, 0.1);
      float center = mix(
        minAxis - width,
        maxAxis + width,
        fract(cc_time.x / period)
      );
      float sweep = 1.0 - smoothstep(width * 0.35, width, abs(axis - center));
      float ri = sweepParams.w;
      float rs = max(diffracParams.y, 0.1);
      float rsp = diffracParams.x;
      float t = axis * rs + cc_time.x * rsp;
      vec3 rainbow = spectrum(t);
      float lum = dot(o.rgb, vec3(0.299, 0.587, 0.114));

      o.rgb = min(
        vec3(1.0),
        o.rgb + rainbow * (0.35 + lum * 0.65) * sweep * ri * o.a
      );
    #endif

    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
